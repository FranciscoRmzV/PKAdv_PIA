<!-- Pantalla de combate. -->
<Page
    x:Class="PKPrueba1.BattlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#101827">

    <!-- Contenedor general con fondo semitransparente. -->
    <Grid Padding="24" Background="#70101827">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera con el mensaje principal y el clima/campo. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="4">
                    <!-- Mensaje principal del combate. -->
                    <TextBlock
            x:Name="MessageText"
            Text="¡Comienza el combate!"
            FontSize="26"
            FontWeight="Bold"
            Foreground="White"
            TextWrapping="Wrap"/>

            <!-- Resumen del clima y los efectos de campo. -->
            <TextBlock
                x:Name="FieldText"
                Foreground="#FDE68A"
                FontSize="14"
                TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Campo de batalla: rival a un lado y jugador al otro. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Datos del rival: entrenador, sprite, nombre, nivel, tipos, barra de PS, estados y Pokémon restantes. -->
            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Padding="28,20"
                CornerRadius="18"
                Background="#B0172033">

                <TextBlock
                    x:Name="TrainerText"
                    FontSize="16"
                    Foreground="#F4B860"
                    TextAlignment="Center"
                    TextWrapping="Wrap"/>

                <!-- Sprite del Pokémon rival. -->
                <Image
                    x:Name="EnemyImage"
                    Width="160"
                    Height="160"
                    Stretch="Uniform"/>

                <TextBlock
                    x:Name="EnemyNameText"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    TextAlignment="Center"/>

                <TextBlock
                    x:Name="EnemyLevelText"
                    Foreground="#CBD5E1"
                    TextAlignment="Center"/>

                <StackPanel
                    x:Name="EnemyTypes"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="4"/>

                <!-- Barra de PS del rival. -->
                <ProgressBar
                    x:Name="EnemyHPBar"
                    Width="180"
                    Height="12"
                    Minimum="0"
                    Maximum="100"
                    Value="100"/>

                <TextBlock
                    x:Name="EnemyHPText"
                    Foreground="White"
                    TextAlignment="Center"/>

                <TextBlock
                    x:Name="EnemyStatusText"
                    Foreground="#FCA5A5"
                    TextAlignment="Center"
                    TextWrapping="Wrap"/>

                <TextBlock
                    x:Name="EnemyTeamText"
                    Foreground="#9DB4CC"
                    TextAlignment="Center"/>
            </StackPanel>

            <!-- Datos del jugador: sprite, nombre, nivel, tipos, barra de PS, mejoras y equipo. -->
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Padding="28,20"
                CornerRadius="18"
                Background="#B0172033">

                <TextBlock
                    Text="Tu Pokémon"
                    FontSize="16"
                    Foreground="#7DD3FC"
                    TextAlignment="Center"/>

                <!-- Sprite del Pokémon del jugador (de espaldas). -->
                <Image
                    x:Name="PlayerImage"
                    Width="160"
                    Height="160"
                    Stretch="Uniform"/>

                <TextBlock
                    x:Name="PlayerNameText"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="White"
                    TextAlignment="Center"/>

                <TextBlock
                    x:Name="PlayerLevelText"
                    Foreground="#CBD5E1"
                    TextAlignment="Center"/>

                <StackPanel
                    x:Name="PlayerTypes"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="4"/>

                <!-- Barra de PS del jugador. -->
                <ProgressBar
                    x:Name="PlayerHPBar"
                    Width="180"
                    Height="12"
                    Minimum="0"
                    Maximum="100"
                    Value="100"/>

                <TextBlock
                    x:Name="PlayerHPText"
                    Foreground="White"
                    TextAlignment="Center"/>

                <TextBlock
                    x:Name="PlayerBoostText"
                    Foreground="#86EFAC"
                    TextAlignment="Center"
                    TextWrapping="Wrap"/>

                <TextBlock
                    x:Name="PlayerTeamText"
                    Foreground="#9DB4CC"
                    TextAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Panel de registro del combate y asistente de combate. -->
        <Border
            Grid.Row="2"
            Background="#99000000"
            CornerRadius="12"
            Padding="14"
            Margin="0,20,0,0">
            <StackPanel Spacing="10">
                <!-- Registro de los últimos mensajes del turno. -->
                <TextBlock x:Name="BattleStatusText" Text="¿Qué quieres hacer?" Foreground="White" FontSize="18" MinHeight="65" TextWrapping="Wrap"/>
                <!-- Botón para mostrar u ocultar el asistente de combate. -->
                <Button x:Name="AdvisorToggleButton" Content="💬 Ayuda para el combate" HorizontalAlignment="Left" Click="AdvisorToggleButton_Click"/>
                <!-- Panel del asistente (oculto por defecto). -->
                <Border x:Name="AdvisorPanel" Visibility="Collapsed" Background="#CC111827" CornerRadius="10" Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Asistente de combate" Foreground="#7DD3FC" FontSize="16" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- Botones de consulta rápida (cada uno envía su pregunta guardada en Tag). -->
                            <Button Content="⚔ ¿Qué ataco?" Tag="¿Qué movimiento debo usar?" Click="AdvisorQuickButton_Click"/>
                            <Button Content="🔄 ¿Cambio?" Tag="¿Conviene cambiar de Pokémon?" Click="AdvisorQuickButton_Click"/>
                            <Button Content="⚡ ¿Quién va primero?" Tag="¿Quién es más rápido en este combate?" Click="AdvisorQuickButton_Click"/>
                            <Button Content="🧬 Tipos" Tag="¿Qué tipos y debilidades tiene el rival?" Click="AdvisorQuickButton_Click"/>
                            <Button Content="❤ Mi vida" Tag="¿Cómo está mi vida?" Click="AdvisorQuickButton_Click"/>
                        </StackPanel>
                        <!-- Historial de la conversación con el asistente. -->
                        <ScrollViewer x:Name="AdvisorScroll" Height="110" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="AdvisorHistory" Foreground="White" TextWrapping="Wrap"/></ScrollViewer>
                        <!-- Fila para escribir una pregunta. -->
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="AdvisorInput" Grid.Column="0" PlaceholderText="Pregunta qué movimiento usar o si conviene cambiar…" MaxLength="240" KeyDown="AdvisorInput_KeyDown"/>
                            <Button x:Name="AdvisorSendButton" Grid.Column="1" Content="Enviar" Click="AdvisorSendButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Botón de megaevolución (atajo: tecla Z). -->
        <Button
            x:Name="MegaButton"
            Grid.Row="3"
            HorizontalAlignment="Center"
            Margin="0,10,0,10"
            Padding="16,6"
            MinWidth="230"
            IsEnabled="False"
            Click="MegaButton_Click"
            ToolTipService.ToolTip="Megaevolucionar al Pokémon activo (tecla Z)">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Border
                    Width="26"
                    Height="26"
                    CornerRadius="6"
                    Background="#33FFFFFF"
                    BorderBrush="#88FFFFFF"
                    BorderThickness="1">
                    <TextBlock
                        Text="Z"
                        FontWeight="Bold"
                        FontSize="15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Border>
                <TextBlock
                    Text="MEGAEVOLUCIONAR"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Botones de acción del jugador: atacar, cambiar, objetos, rendirse, estadísticas y continuar. -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button
                x:Name="AttackButton"
                Grid.Row="0"
                Grid.Column="0"
                Content="Atacar"
                Margin="5"
                Padding="12"
                HorizontalAlignment="Stretch"
                Click="AttackButton_Click"/>

            <Button
                x:Name="SwitchButton"
                Grid.Row="0"
                Grid.Column="1"
                Content="Cambiar Pokémon"
                Margin="5"
                Padding="12"
                HorizontalAlignment="Stretch"
                Click="SwitchButton_Click"/>

            <Button
                x:Name="ItemButton"
                Grid.Row="1"
                Grid.Column="0"
                Content="Objetos"
                Margin="5"
                Padding="12"
                HorizontalAlignment="Stretch"
                Click="ItemButton_Click"/>

            <Button
                x:Name="SurrenderButton"
                Grid.Row="1"
                Grid.Column="1"
                Content="Rendirse"
                Margin="5"
                Padding="12"
                HorizontalAlignment="Stretch"
                Click="SurrenderButton_Click"/>

            <Button
                x:Name="StatsButton"
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Content="Ver estadísticas"
                Margin="5"
                Padding="12"
                HorizontalAlignment="Stretch"
                Click="StatsButton_Click"/>

            <Button
                x:Name="ContinueButton"
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.ColumnSpan="2"
                Content="Continuar"
                Margin="5"
                Padding="12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                Click="ContinueButton_Click"/>
        </Grid>
    </Grid>
</Page>

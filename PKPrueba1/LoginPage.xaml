<!-- Pantalla de inicio de sesión y registro. -->
<Page
    x:Class="PKPrueba1.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Contenedor de la página. -->
    <Grid>

        <!-- Permite desplazarse si la ventana es pequeña. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <!-- Tarjeta central del formulario. -->
            <Border
                Width="450"
                Padding="36"
                Margin="0,30"
                CornerRadius="22"
                Background="#E6182438"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!-- Contenido del formulario. -->
                <StackPanel Spacing="16">

                    <!-- Título del juego. -->
                    <TextBlock
                        Text="POKÉMON ADVENTURE"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"
                        HorizontalAlignment="Center"/>

                    <!-- Subtítulo con instrucciones. -->
                    <TextBlock
                        x:Name="SubtitleText"
                        Text="Inicia sesión o crea una cuenta"
                        Foreground="#AAB8CC"
                        HorizontalAlignment="Center"/>

                    <!-- Campo de nombre de usuario. -->
                    <TextBox
                        x:Name="UsernameBox"
                        Header="Usuario"
                        PlaceholderText="Introduce tu usuario"
                        MaxLength="20"
                        TextChanged="UsernameBox_TextChanged"
                        KeyDown="UsernameBox_KeyDown"/>

                    <!-- Campo de contraseña. -->
                    <PasswordBox
                        x:Name="PasswordBox"
                        Header="Contraseña"
                        MaxLength="64"
                        PasswordChanged="PasswordBox_PasswordChanged"
                        KeyDown="PasswordBox_KeyDown"/>

                    <!-- Campo para repetir la contraseña (solo al crear cuenta). -->
                    <PasswordBox
                        x:Name="ConfirmBox"
                        Header="Repetir contraseña (solo al crear cuenta)"
                        MaxLength="64"
                        KeyDown="ConfirmBox_KeyDown"/>

                    <!-- Panel con los requisitos de la contraseña; se rellena desde el código. -->
                    <Border
                        Background="#33000000"
                        CornerRadius="10"
                        Padding="12">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Text="Requisitos de la contraseña (al crear cuenta):"
                                Foreground="#CBD5E1"
                                FontSize="12"
                                FontWeight="SemiBold"/>
                            <StackPanel x:Name="RequirementsPanel" Spacing="1"/>
                        </StackPanel>
                    </Border>

                    <!-- Botón para iniciar sesión. -->
                    <Button
                        x:Name="LoginButton"
                        Content="INICIAR SESIÓN"
                        HorizontalAlignment="Stretch"
                        Padding="12"
                        Click="Login_Click"/>

                    <!-- Botón para crear una cuenta nueva. -->
                    <Button
                        x:Name="RegisterButton"
                        Content="CREAR CUENTA"
                        HorizontalAlignment="Stretch"
                        Padding="12"
                        Click="Register_Click"/>

                    <!-- Mensajes de error o estado. -->
                    <TextBlock
                        x:Name="StatusText"
                        Foreground="#FF7777"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</Page>

<!-- Pantalla del modo Gimnasios (preparación del equipo y partida en curso). -->
<Page
    x:Class="PKPrueba1.GymPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#111827">

    <!-- Contenedor con tres filas: cabecera, contenido y botones. -->
    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera: título, estado y récord. -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock
                Text="GIMNASIOS"
                FontSize="36"
                FontWeight="Bold"
                Foreground="White"/>

            <TextBlock
                x:Name="StatusText"
                FontSize="18"
                Foreground="#F4B860"
                TextWrapping="Wrap"/>

            <TextBlock
                x:Name="RecordText"
                FontSize="14"
                Foreground="#9DB4CC"/>
        </StackPanel>

        <!-- Panel de preparación (antes de empezar el desafío): elegir el equipo. -->
        <Grid x:Name="BuilderPanel" Grid.Row="1" Margin="0,16,0,16" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Texto con las reglas del desafío. -->
            <TextBlock
                Grid.Row="0"
                Foreground="#E2E8F0"
                FontSize="15"
                TextWrapping="Wrap"
                Text="Derrota a los 8 líderes de gimnasio de Kanto, al Alto Mando y al Campeón, uno tras otro. Todos los Pokémon luchan a nivel 100. Tras cada victoria eliges 3 objetos de 9. Elige tu equipo (hasta 6 Pokémon):"/>

            <!-- Fila con el buscador de Pokémon y el botón del asistente de equipos. -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                <!-- Buscador por nombre. -->
                <TextBox
                    x:Name="SearchBox"
                    PlaceholderText="Buscar Pokémon por nombre..."
                    Width="400"
                    TextChanged="SearchBox_TextChanged"/>
                <!-- Botón para mostrar u ocultar el asistente de equipos. -->
                <Button
                    x:Name="TeamAdvisorToggleButton"
                    Content="💬 Asistente de equipos"
                    Padding="14,6"
                    Click="TeamAdvisorToggleButton_Click"/>
            </StackPanel>

            <!-- Texto con el equipo elegido (máximo 6). -->
            <TextBlock
                x:Name="SelectedText"
                Grid.Row="2"
                Foreground="#86EFAC"
                FontSize="15"
                TextWrapping="Wrap"/>

            <!-- Cuadrícula de selección múltiple con todos los Pokémon. -->
            <GridView
                x:Name="PokemonGrid"
                Grid.Row="3"
                SelectionMode="Multiple"
                IsItemClickEnabled="False"
                SelectionChanged="PokemonGrid_SelectionChanged"/>

            <!-- Panel del asistente de equipos (oculto por defecto). -->
            <Border
                x:Name="TeamAdvisorPanel"
                Grid.Column="1"
                Grid.Row="0"
                Grid.RowSpan="4"
                Width="420"
                Margin="16,0,0,0"
                Padding="14"
                Background="#0B1220"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="Asistente de equipos"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"/>

                    <!-- Historial de la conversación con el asistente. -->
                    <ScrollViewer x:Name="TeamAdvisorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="TeamAdvisorHistory"
                            Foreground="#E2E8F0"
                            FontSize="13"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            Margin="0,0,8,0"/>
                    </ScrollViewer>

                    <!-- Botones de preguntas rápidas. -->
                    <StackPanel Grid.Row="2" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="🏆 Completo" FontSize="12" Padding="10,4" Tag="Recomiéndame un equipo para los gimnasios y la liga" Click="TeamAdvisorQuick_Click"/>
                            <Button Content="🏅 Gimnasios" FontSize="12" Padding="10,4" Tag="Recomiéndame un equipo para los 8 gimnasios" Click="TeamAdvisorQuick_Click"/>
                            <Button Content="👑 Liga" FontSize="12" Padding="10,4" Tag="Recomiéndame un equipo para el Alto Mando y el Campeón" Click="TeamAdvisorQuick_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="🔍 Analizar mi equipo" FontSize="12" Padding="10,4" Tag="Analiza mi equipo, ¿qué le falta?" Click="TeamAdvisorQuick_Click"/>
                            <Button Content="❓ Ayuda" FontSize="12" Padding="10,4" Tag="¿Qué puedes hacer?" Click="TeamAdvisorQuick_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Botón para aplicar el equipo recomendado. -->
                    <Button
                        x:Name="ApplyTeamButton"
                        Grid.Row="3"
                        Content="Usar este equipo"
                        HorizontalAlignment="Stretch"
                        Padding="14,8"
                        Visibility="Collapsed"
                        Click="ApplyTeamButton_Click"/>

                    <!-- Fila para escribir una pregunta al asistente. -->
                    <Grid Grid.Row="4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="TeamAdvisorInput"
                            Grid.Column="0"
                            PlaceholderText="Ej: equipo contra Misty, ¿sirve Gengar?"
                            MaxLength="240"
                            KeyDown="TeamAdvisorInput_KeyDown"/>
                        <Button
                            x:Name="TeamAdvisorSendButton"
                            Grid.Column="1"
                            Content="Enviar"
                            Padding="14,6"
                            Click="TeamAdvisorSendButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Panel de partida en curso: rival actual, medallas y equipo. -->
        <ScrollViewer x:Name="RunPanel" Grid.Row="1" Margin="0,16,0,16" Visibility="Collapsed">
            <StackPanel Spacing="16">

                <!-- Banner del gimnasio con imagen de fondo y texto. -->
                <Border
                    x:Name="GymBanner"
                    Height="150"
                    CornerRadius="12">
                    <Grid>
                        <Image
                            x:Name="GymImage"
                            Stretch="UniformToFill"/>
                        <Border Background="#88000000" Padding="16">
                            <TextBlock
                                x:Name="GymText"
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="White"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Medallas conseguidas. -->
                <TextBlock
                    x:Name="BadgeText"
                    FontSize="15"
                    Foreground="#F4B860"
                    TextWrapping="Wrap"/>

                <!-- Equipo del próximo rival. -->
                <TextBlock
                    x:Name="OpponentText"
                    FontSize="16"
                    Foreground="#E2E8F0"
                    TextWrapping="Wrap"/>

                <!-- Título "Tu equipo". -->
                <TextBlock
                    Text="Tu equipo"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"/>

                <!-- Tarjetas de los Pokémon del equipo; se rellena desde el código. -->
                <StackPanel x:Name="TeamPanel" Spacing="10"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Barra inferior de botones. -->
        <StackPanel Grid.Row="2" Spacing="10">
            <!-- Primera fila de botones: comenzar, combatir, objetos y primer Pokémon. -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="StartButton"
                    Content="COMENZAR DESAFÍO"
                    Padding="18,10"
                    Click="StartButton_Click"/>
                <Button
                    x:Name="FightButton"
                    Content="COMBATIR"
                    Padding="18,10"
                    Click="FightButton_Click"/>
                <Button
                    x:Name="ItemButton"
                    Content="USAR OBJETO"
                    Padding="18,10"
                    Click="ItemButton_Click"/>
                <Button
                    x:Name="LeadButton"
                    Content="PRIMER POKÉMON"
                    Padding="18,10"
                    Click="LeadButton_Click"/>
            </StackPanel>
            <!-- Segunda fila de botones: abandonar y menú. -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="AbandonButton"
                    Content="ABANDONAR"
                    Padding="18,10"
                    Click="AbandonButton_Click"/>
                <Button
                    x:Name="BackButton"
                    Content="MENÚ"
                    Padding="18,10"
                    Click="Back_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
